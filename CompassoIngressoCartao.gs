// ============================================================================
// 🎟️ ARQUIVO: CompassoIngressoCartao.gs
// 🏷️  SISGEP — Página pública do ingresso da festa (cartão), 16/11/2026
// ============================================================================
//
// O QUE É. O link da mensagem de WhatsApp do ingresso ("Acesse ou baixe seu ingresso") abre esta página: um cartão com o logo
// do sindicato, as informações da festa e o botão "Baixar meu ingresso (PDF)". O usuário escolheu a opção A do desenho (lilás,
// no estilo do modelo dele), com SÓ O PRIMEIRO NOME e a página no link (e não uma imagem anexada à mão).
//
// QUEM É O ENDEREÇO. Rota pública, sem login: ?page=ingresso-festa&c=<código do ingresso no TickOne>. O código (8 letras/números
// sorteados pelo TickOne) é a credencial: quem não o tem vê a página "ingresso não encontrado". A página mostra o PRIMEIRO NOME,
// os dados da festa e o link do PDF — que já é aberto por decisão do usuário (ArquivoDrive.gs, exceção ingresso_festa). Não mostra
// CPF, telefone, escola nem sobrenome. NÃO faz check-in: ver o cartão não é entrar.
//
// DE ONDE VÊM OS DADOS. Nome e código: a base que o robô lê do TickOne. PDF: a pasta INGRESSOS FESTA COMPASSO 2026. Data, horários e
// local: o cadastro da festa (compasso_dadosDaFesta_), o mesmo da mensagem de WhatsApp.
//
// TAMANHO. O projeto Apps Script está perto do limite; o logo vai reduzido (340 px, ~18 KB) em vez do arquivo original (195 KB).
// ============================================================================

var CING_CARTAO_LOGO = "data:image/webp;base64,";

function cingCartaoEsc_(s) {
  return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;");
}

function cingCartaoIcone_(nome) {
  var a = '<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">';
  var m = {
    cal:   a + '<rect x="3" y="4.5" width="18" height="16" rx="3"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/><path d="M7.5 13h2M11 13h2M14.5 13h2M7.5 16.5h2M11 16.5h2"/></svg>',
    clock: a + '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>',
    door:  a + '<path d="M6 21V4.5A1.5 1.5 0 0 1 7.5 3h9A1.5 1.5 0 0 1 18 4.5V21"/><path d="M3 21h18"/><circle cx="14.5" cy="12.5" r=".8" fill="currentColor"/></svg>',
    pin:   '<svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.6" fill="#fff"/></svg>',
    doc:   a + '<path d="M6 2.5h8l5 5V21a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1z"/><path d="M14 2.5V8h5M8.5 13h7M8.5 16.5h7"/></svg>',
    link:  a + '<path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1"/><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1"/></svg>',
    warn:  a + '<path d="M12 3.2 2.4 20h19.2z"/><path d="M12 9.5v5M12 17.6v.1"/></svg>',
    ok:    '<svg viewBox="0 0 24 24" width="28" height="28"><rect x="2" y="2" width="20" height="20" rx="5" fill="#16a34a"/><path d="M6.5 12.5l3.8 3.8 7.2-8" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>'
  };
  return m[nome] || "";
}

/** Id do arquivo do Drive a partir do link de visualização (…/file/d/<ID>/view). */
function cingCartaoIdDoLink_(url) {
  var m = String(url || "").match(/\/file\/d\/([A-Za-z0-9_-]+)/);
  return m ? m[1] : "";
}

/** O cartão em HTML (função pura: recebe os dados prontos). nome = SÓ o primeiro nome; pdfUrl = link do PDF no Drive ou "". */
function cingCartaoHtml_(nome, pdfUrl, f) {
  var e = cingCartaoEsc_, id = cingCartaoIdDoLink_(pdfUrl);
  var quando = ""; try { quando = compasso_dataPorExtenso_(f.data); } catch (x) { quando = ""; }
  quando = quando ? quando.charAt(0).toUpperCase() + quando.slice(1) : "";
  var lin = function (ic, corpo) { return '<div class="lin">' + cingCartaoIcone_(ic) + '<div>' + corpo + '</div></div>'; };
  var h = '<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">' +
    '<title>Seu ingresso — Festa No Compasso da Vida 2026</title><style>' +
    '*{box-sizing:border-box;margin:0;padding:0}body{background:#f3eefb;font-family:"Segoe UI",Roboto,Arial,sans-serif;color:#1f1b3a;padding:14px}' +
    '.card{max-width:560px;margin:0 auto;background:#fff;border-radius:24px;padding:24px 22px 0;box-shadow:0 10px 34px rgba(30,20,80,.14);overflow:hidden}' +
    '.logo{display:block;margin:0 auto 12px;height:84px;width:auto}h1{font-size:30px;font-weight:800;color:#2a1860;margin-bottom:6px}' +
    '.lead{font-size:18px;line-height:1.4;margin-bottom:16px}.lead b{color:#2a1860}' +
    '.pan{background:#ece4fa;border:1.5px solid #d9cdf5;border-radius:16px;padding:14px;margin-bottom:16px}' +
    '.pan h2{font-size:18px;font-weight:800;color:#2a1860;display:inline-block;background:#fff;border:1.5px solid #d9cdf5;border-radius:11px;padding:5px 12px;margin-bottom:8px}' +
    '.chk{display:flex;gap:10px;align-items:flex-start;font-size:16px;line-height:1.4;margin:8px 0;background:#f6f1fd;border-radius:11px;padding:8px 9px}.chk svg{flex:none}' +
    '.lin{display:flex;gap:12px;align-items:flex-start;font-size:18px;margin:10px 0}.lin svg{flex:none;color:#6d28d9;margin-top:1px}' +
    '.lin small{display:block;font-size:15px;color:#5b5675;line-height:1.4;margin-top:3px}' +
    '.sep{height:1.5px;background:#d9cdf5;margin:14px 0}.pdf{display:flex;gap:12px;align-items:flex-start;font-size:17px;line-height:1.4;margin:6px 0 14px}' +
    '.pdf svg{flex:none;color:#6d28d9}.pdf small{display:block;font-size:15px;color:#5b5675;margin-top:3px}' +
    '.btn{display:block;text-align:center;text-decoration:none;background:#6d28d9;color:#fff;font-weight:800;font-size:19px;border-radius:14px;padding:15px;margin:0 0 10px}' +
    '.btn2{display:block;text-align:center;text-decoration:none;color:#4338ca;font-weight:700;font-size:16px;padding:8px;margin:0 0 14px}' +
    '.sem{background:#fff6e5;border:1.5px solid #f3cf8a;border-radius:14px;padding:12px;font-size:16px;line-height:1.4;margin-bottom:14px}' +
    '.imp{display:flex;gap:10px;align-items:flex-start;border:1.5px solid #f0b8b8;background:#fff6f6;border-radius:14px;padding:11px 12px;font-size:16px;line-height:1.4;margin-bottom:16px;color:#3a1d1d}.imp svg{flex:none;color:#d62f2f}' +
    '.faixa{margin:0 -22px;background:linear-gradient(90deg,#4c1d95,#7c3aed,#4c1d95);color:#fff;text-align:center;font-weight:800;font-size:17px;padding:14px 16px}' +
    '.rod{margin:0 -22px;background:#ece4fa;text-align:center;font-weight:800;font-size:20px;color:#2a1860;padding:13px}' +
    '</style></head><body><div class="card"><img class="logo" alt="SindEducação-ES" src="' + CING_CARTAO_LOGO + '">' +
    '<h1>Olá, ' + e(nome) + '! 🎉</h1>' +
    '<div class="lead">Sua inscrição na <b>Festa No Compasso da Vida 2026</b> foi confirmada, e seu ingresso já está pronto! 🎟️</div>' +
    '<div class="pan"><h2>Na entrada, apresente:</h2>' +
    '<div class="chk">' + cingCartaoIcone_("ok") + '<div>O QR Code do ingresso em PDF (na tela do celular ou impresso);</div></div>' +
    '<div class="chk">' + cingCartaoIcone_("ok") + '<div>Um <b>documento oficial com foto</b> (RG, CNH ou outro), para conferência.</div></div></div>';
  if (quando) h += lin("cal", '<b>Data:</b> ' + e(quando));
  if (f.horaInicio) h += lin("clock", '<b>Horário:</b> ' + e(f.horaInicio));
  if (f.horaAbertura) h += lin("door", '<b>Abertura dos portões:</b> ' + e(f.horaAbertura));
  if (f.local) {
    var sm = [];
    if (f.endereco) sm.push(e(f.endereco));
    if (f.referencia) sm.push("(" + e(String(f.referencia).replace(/\.$/, "")) + ")");
    h += lin("pin", '<b>Local:</b> ' + e(f.local) + (sm.length ? '<small>' + sm.join('<br>') + '</small>' : ''));
  }
  h += '<div class="sep"></div><div class="pdf">' + cingCartaoIcone_("doc") + '<div><b>Seu ingresso com QR Code está disponível em PDF.</b><small>Guarde o arquivo no celular para apresentar na entrada.</small></div></div>';
  if (id) {
    h += '<a class="btn" href="https://drive.google.com/uc?export=download&amp;id=' + e(id) + '">⬇ Baixar meu ingresso (PDF)</a>' +
         '<a class="btn2" href="' + e(pdfUrl) + '">Abrir o PDF na tela</a>';
  } else {
    h += '<div class="sem">O PDF do seu ingresso ainda está sendo preparado. Se ele não chegou, fale com a secretaria do sindicato.</div>';
  }
  h += '<div class="imp">' + cingCartaoIcone_("warn") + '<div><b>Importante:</b> O ingresso é pessoal e válido para apenas uma entrada. Não compartilhe o arquivo com outras pessoas.</div></div>' +
       '<div class="faixa">Esperamos você para uma noite especial de celebração! 🎶🥳</div><div class="rod">SindEducação-ES</div></div></body></html>';
  return h;
}

function cingCartaoNaoEncontrado_() {
  return '<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ingresso não encontrado</title>' +
    '<style>body{font-family:"Segoe UI",Arial,sans-serif;background:#f3eefb;color:#1f1b3a;padding:24px;text-align:center}.c{max-width:460px;margin:40px auto;background:#fff;border-radius:20px;padding:28px;box-shadow:0 10px 34px rgba(30,20,80,.14)}</style></head>' +
    '<body><div class="c"><img alt="" style="height:70px" src="' + CING_CARTAO_LOGO + '"><h2 style="margin:14px 0 8px;color:#2a1860">Ingresso não encontrado</h2><p>Confira o link que você recebeu. Se o problema continuar, fale com a secretaria do SindEducação-ES.</p></div></body></html>';
}

/** Rota pública (Code.gs: ?page=ingresso-festa&c=<código>). */
function compassoIngressoCartao_pagina_(codigo) {
  var html;
  try {
    codigo = String(codigo || "").trim().toUpperCase();
    if (!/^[A-Z0-9-]{4,20}$/.test(codigo)) throw new Error("codigo");
    var base = cingLerBase_();
    var l = base && base.linhas.filter(function (x) { return String(x.codigo).toUpperCase() === codigo; })[0];
    if (!l) throw new Error("nao achou");
    var nome = String(l.nome || "").trim().split(/\s+/)[0] || "";
    nome = nome ? nome.charAt(0).toUpperCase() + nome.slice(1).toLowerCase() : "";
    var pdf = ""; try { pdf = cingPdfs_()[cingNomeChave_(l.nome)] || ""; } catch (eP) { pdf = ""; }
    var f = {}; try { f = compasso_dadosDaFesta_() || {}; } catch (eF) { f = {}; }
    html = cingCartaoHtml_(nome, pdf, f);
  } catch (e) { html = cingCartaoNaoEncontrado_(); }
  return HtmlService.createHtmlOutput(html)
    .setTitle("Seu ingresso — Festa No Compasso da Vida 2026")
    .addMetaTag("viewport", "width=device-width, initial-scale=1.0")
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}
